{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "effect-tsgo --tsrs-lint vp check",
    "lint": "effect-tsgo --tsrs-lint vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "tsrs": "catalog:tooling",
    "vite": "catalog:tooling",
    "vite-plus": "catalog:tooling"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
