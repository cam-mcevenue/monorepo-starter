{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Rules only. Nothing here emits: a publishable package's tsconfig.build.json
  // switches emit on and owns every output option.
  "compilerOptions": {
    "noEmit": true,
    // Modules
    "allowImportingTsExtensions": true,
    "target": "es2025",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force", // Treat every non-declaration file as a module.
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true, // Rewrite `.ts` imports to `.js` when a build emits.
    // Interop
    "erasableSyntaxOnly": true, // Allows to run directly with node and type removal
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true, // Only transform/eliminate type-only import/export statements.
    // Opt-in to stricter type checking and correctness guard rails.
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "noErrorTruncation": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    // Stuff to not check
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "types": [] // No ambient @types/*; each project opts in, e.g. ["node"].
  },
  "extends": "./tsconfig.effect.json"
}
