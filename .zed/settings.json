{
  "lsp": {
    "oxlint": {
      // Run Oxlint through effect-tsgo, which loads the Effect-patched binding,
      // the same way `vpr lint` does, with type-aware rules on tsrs. The stock
      // binary rejects the effecttsgo plugin.
      "binary": {
        "path": "node_modules/.bin/effect-tsgo",
        "arguments": ["--tsrs-lint", "oxlint", "--lsp"]
      },
      "initialization_options": {
        "settings": {
          "run": "onType",
          "fixKind": "safe_fix",
          "typeAware": true,
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "effect-tsgo": {
      // The Effect-patched tsrs, at the version pinned in package.json.
      "binary": {
        "path": "node_modules/.bin/effect-tsgo",
        "arguments": ["tsrs", "--lsp", "--stdio"]
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": "./vite.config.ts",
          "run": "onSave"
        }
      }
    },
    "effect-tsgo": {}
  },
  "languages": {
    "CSS": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "HTML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JavaScript": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        },
        {
          "code_action": "source.fixAll.oxc"
        }
      ],
      "language_servers": [
        "effect-tsgo",
        "oxlint",
        "!vtsls",
        "!typescript-language-server",
        "!typescript-ls"
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSONC": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Markdown": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TypeScript": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "language_servers": [
        "effect-tsgo",
        "oxlint",
        "!vtsls",
        "!typescript-language-server",
        "!typescript-ls"
      ]
    },
    "TSX": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ],
      "language_servers": [
        "effect-tsgo",
        "oxlint",
        "!vtsls",
        "!typescript-language-server",
        "!typescript-ls"
      ]
    },
    "YAML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  }
}
